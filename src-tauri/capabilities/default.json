{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: local filesystem browsing for the music library and native file/folder dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "C:/**" }, { "path": "D:/**" }, { "path": "E:/**" }]
    }
  ]
}
